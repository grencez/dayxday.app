(dayxday.app  ; Toplevel repository dir.
 LICENSE  ; License information (already exists)
 .git  ; Git repository directory.
 .gitignore  ; Specifies intentionally untracked files that Git should ignore.
 manifest.json
 package.json  ; Project metadata and dependencies.
 package-lock.json  ; Dependency lock file.
 vite.config.mts  ; Vite configuration file.
 (doc  ; Documentation
  (design  ; Design documents
   architecture.md
   dirmap.sxpb  ; Directory structure of codebase. This file.
   initial_design.md  ; Initial design document
   (decision
    pinia.md
   )
  )
  (plan
   done_by_name.sxpb
   now.sxpb
   todo_by_name.sxpb
  )
  (styleguide
   filepath_style.md
   variable_style.md
  )
  (uat
   activity_resize.md
   activity_squish.md
  )
 )
 (src  ; Source code.
  App.vue  ; Root component
  index.html
  main.mts  ; Entry point for the Vue app
  router.mts  ; Vue Router configuration
  (asset  ; Static assets (images, fonts, etc.)
   (image
    logo.png
   )
   (style  ; Global styles.
    main.css
   )
  )
  (component  ; Reusable Vue components.
   ActivityItem.vue
  )
  (composable  ; Reusable Vue composition functions.
   useDragAndDrop.mts
   useTimeFormatter.ts
  )
  (function
   calculateSnappedY.ts
   isMouseInTimeMarkers.ts
   updateActivityElementStyle.ts
  )
  (store
   activity.ts
  )
  (view
   DayView.vue
  )
 )
 (test  ; Unit and integration tests.
  (component
   ActivityItem.spec.mts
  )
  (composable
   useDragAndDrop.spec.mts
  )
  (store
   activity.spec.mts
  )
  (view
   DayView.spec.mts
  )
 )
 (node_modules)  ; Node.js dependencies (ignored by git).
)
