(test_drag_and_drop
 (description Test that drag-and-drop events resize the activities as desired.)
)
(acceptance_test_md
 (requirement_by_index ()
  (1 Use a new directory in doc/uat/.)
  (2 Be brief, so that anyone can skim and understand what's is important.)
  (3 Include a short identifying name for the user interaction.)
  (4 Include a UAT for user clicking on an activity. When dragging the mouse after clicking, it should change that activity's duration and adjust all later activitivity start times accordingly.)
  (5 Include a UAT for user clicking on the border between two activities. When dragging the border, the duration of the earlier activity should change, and the start time for the later activity should change, along with its duration so that later activities are unaffected.)
  (6 Include a UAT for clicking on either an activity or a border)
 )
)
(restructure
 (requirement_by_index ()
  (1 Use `src/store/` instead of `src/asset/store/`.)
  (2 Move `src/asset/model/Activity.ts` to `src/model/Activity.ts`.)
  (3 Move files in `src/asset/function/` to `src/function/`.)
  (4 Move files in `src/asset/composable/` to `src/composable/`.)
  (5 Update import statements in all files to reflect new file locations.)
  (6 Update `doc/design/dirmap.sxpb` to reflect the completed changes, including keeping the `src/asset` directory for static assets.)
 )
 (completed_requirement_indices (())
)
)
(remove_activity
 (description Add a removeActivity action to the store.)
